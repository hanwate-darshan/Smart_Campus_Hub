PORT=5000
MONGO_URI=mongodb+srv://your_db_user:your_db_password@cluster0.mongodb.net/smart-campus-hub?retryWrites=true&w=majority
REDIS_URL=rediss://default:your_redis_password@your_redis_url:6379

JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Format: [[lng, lat], [lng, lat], ...]
CAMPUS_POLYGON_COORDS=[[73.856,18.520],[73.860,18.520],[73.860,18.524],[73.856,18.524]]

